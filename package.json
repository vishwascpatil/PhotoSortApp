{
  "name": "photosort",
  "version": "1.0.0",
  "description": "PhotoSort — All your memories, organized beautifully. An intelligent offline desktop photo manager.",
  "main": "./out/main/index.js",
  "author": "PhotoSort",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:all": "electron-vite build && electron-builder --win --mac --publish never"
  },
  "build": {
    "appId": "com.photosort.app",
    "productName": "PhotoSort",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "!node_modules/**/build/Release/.deps",
      "!node_modules/**/build/Release/obj*"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/sharp/**/*",
      "node_modules/sql.js/**/*",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/tesseract.js/**/*",
      "node_modules/tesseract.js-core/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png",
      "sign": false,
      "signDlls": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "category": "public.app-category.photography",
      "icon": "build/icon.icns"
    },
    "dmg": {
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    }
  },
  "dependencies": {
    "@types/leaflet": "^1.9.21",
    "@vladmandic/face-api": "^1.7.15",
    "exif-reader": "^2.0.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "heic-convert": "^2.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.0",
    "sharp": "^0.33.5",
    "sql.js": "^1.11.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@tanstack/react-virtual": "^3.11.2",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.0"
  }
}
