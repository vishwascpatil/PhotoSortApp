{
  "name": "photovault",
  "version": "1.0.0",
  "description": "An offline Google Photos clone for desktop",
  "main": "./out/main/index.js",
  "author": "PhotoVault",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview"
  },
  "build": {
    "appId": "com.photovault.app",
    "productName": "PhotoVault",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.photography"
    }
  },
  "dependencies": {
    "@types/leaflet": "^1.9.21",
    "@vladmandic/face-api": "^1.7.15",
    "exif-reader": "^2.0.1",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "heic-convert": "^2.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.0",
    "sharp": "^0.33.5",
    "sql.js": "^1.11.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@tanstack/react-virtual": "^3.11.2",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.0"
  }
}
